{
  "name": "msg-viewer",
  "displayName": "MSG Viewer",
  "description": "Preview Outlook .msg files with rich HTML rendering — subject, sender, recipients, body, and inline attachments",
  "version": "0.0.1",
  "publisher": "will",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "msgViewer.preview",
        "displayName": "MSG Preview",
        "selector": [
          {
            "filenamePattern": "*.msg"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "msgViewer.preview",
        "title": "Preview MSG File"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.28.0"
  },
  "license": "MIT"
}